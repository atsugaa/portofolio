---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Agusta | Portofolio",
  description = "Portofolio Agusta, fresh graduate Teknik Informatika.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />

    <title>{title}</title>

    <link rel="icon" type="image/svg" href="/favicon.svg" />
  </head>

  <body>
    <slot />
  </body>
</html>