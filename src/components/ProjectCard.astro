---
import type { Project } from "../types";
import {
  siGithub,
  siHuggingface,
} from "simple-icons/icons";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const iconMap: Record<string, any> = {
  github: siGithub,
  huggingface: siHuggingface,
};

const labelMap: Record<string, string> = {
  github: "GitHub",
  huggingface: "Hugging Face",
  demo: "Demo",
  gameplay: "Gameplay",
};
---

<article
  class="group flex flex-col overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)] transition duration-300 hover:-translate-y-1 hover:border-[var(--primary)]/30 hover:shadow-xl md:min-h-[390px] md:flex-row"
>
  <!-- Project Image -->
  {project.image && (
    <div
      class="relative aspect-video w-full shrink-0 overflow-hidden bg-[var(--border)] md:aspect-auto md:w-[48%]"
    >
      <img
        src={`${import.meta.env.BASE_URL}${project.image.replace(/^\/+/, "")}`}
        alt={project.title}
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"
      />
    </div>
  )}

  <!-- Project Information -->
  <div
    class="flex min-w-0 flex-1 flex-col justify-center p-6 sm:p-8 md:p-10"
  >
    <!-- Category & Year -->
    <div class="flex items-center justify-between gap-4">
      <span
        class="text-xs font-bold uppercase tracking-[0.1em] text-[var(--primary)]"
      >
        {project.category}
      </span>

      {project.year && (
        <span class="shrink-0 text-xs text-[var(--muted)]">
          {project.year}
        </span>
      )}
    </div>

    <!-- Title -->
    <h3 class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">
      {project.title}
    </h3>

    <!-- Description -->
    <p
      class="mt-4 max-w-xl text-sm leading-7 text-[var(--muted)] sm:text-base"
    >
      {project.description}
    </p>

    <!-- Technologies -->
    {project.technologies.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-2">
        {project.technologies.map((technology) => (
          <span
            class="rounded-full bg-[var(--primary)]/8 px-3 py-1.5 text-xs font-medium text-[var(--primary)]"
          >
            {technology}
          </span>
        ))}
      </div>
    )}

    <!-- Links -->
    {project.links && project.links.length > 0 && (
      <div class="mt-7 flex flex-wrap gap-x-5 gap-y-3">
        {project.links.map((link) => {
          const icon = iconMap[link.type];

          return (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${labelMap[link.type]} - ${project.title}`}
              class="group/link inline-flex items-center gap-2 text-sm font-semibold transition-colors duration-200 hover:text-[var(--primary)]"
            >
              {icon ? (
                <svg
                  viewBox="0 0 24 24"
                  class="h-4 w-4 shrink-0"
                  fill={`#${icon.hex}`}
                  aria-hidden="true"
                >
                  <path d={icon.path} />
                </svg>
              ) : link.type === "demo" ? (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  class="h-4 w-4 shrink-0"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13.5 6H19v5.5"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M18.5 6.5L12 13"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19 13.5V18a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h4.5"
                  />
                </svg>
              ) : (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="h-4 w-4 shrink-0"
                  aria-hidden="true"
                >
                  <path
                    d="M8 5.5v13a1 1 0 0 0 1.5.86l10-6.5a1 1 0 0 0 0-1.72l-10-6.5A1 1 0 0 0 8 5.5Z"
                  />
                </svg>
              )}

              <span>{labelMap[link.type]}</span>
              <span
                aria-hidden="true"
                class="relative flex h-4 w-4 items-center justify-center overflow-hidden"
              >
                <svg
                  viewBox="0 0 16 16"
                  fill="none"
                  class="absolute h-3.5 w-3.5 translate-x-0 translate-y-0 transition-transform duration-300 ease-out group-hover/link:translate-x-1 group-hover/link:-translate-y-1"
                >
                  <path
                    d="M4 12L12 4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                  <path
                    d="M6.5 4H12V9.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          );
        })}
      </div>
    )}
  </div>
</article>