---
import { profile } from "../data/profile";
---

<section
  class="container flex min-h-[calc(100vh-4rem)] items-center py-16 sm:py-20 lg:py-24"
>
  <div
    class="grid w-full items-center gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16"
  >

    <!-- Content -->
    <div class="max-w-4xl">

      <p
        class="mb-5 flex items-center gap-3 text-sm font-semibold text-[var(--primary)]"
      >
        <span class="h-2 w-2 rounded-full bg-[var(--accent)]"></span>
        {profile.role}
      </p>

      <h1
        class="text-5xl font-bold tracking-[-0.05em] sm:text-6xl lg:text-7xl xl:text-8xl"
        style="line-height: 0.95;"
      >
        Halo, saya <span class="text-[var(--primary)]">{profile.name}.</span>
      </h1>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href={`${import.meta.env.BASE_URL}/documents/cv.pdf`}
          target="_blank"
          rel="noopener noreferrer"
          class="button button-primary"
        >
          Lihat CV
        </a>

        <a
          href="#contact"
          class="button button-secondary"
        >
          Hubungi Saya
        </a>
      </div>

    </div>


    <!-- Avatar -->
    <div class="flex justify-center lg:justify-end">

      <div class="relative">

        <!-- Decorative Circle -->
        <div
          class="absolute -right-5 -top-5 h-28 w-28 rounded-full bg-[var(--accent)]/20 blur-2xl"
        ></div>

        <div
          class="absolute -bottom-5 -left-5 h-24 w-24 rounded-full bg-[var(--primary)]/15 blur-2xl"
        ></div>

        <!-- Avatar Background -->
        <div
          class="relative flex h-64 w-64 items-center justify-center rounded-full bg-gradient-to-br from-[var(--primary)]/15 to-[var(--accent)]/15 sm:h-72 sm:w-72 lg:h-80 lg:w-80"
        >

          <!-- Avatar Image -->
          <div
            class="h-[88%] w-[88%] overflow-hidden rounded-full border-4 border-[var(--surface)] bg-[var(--surface)] shadow-2xl"
          >
            <img
              src={`${import.meta.env.BASE_URL}/images/avatar.jpg`}
              alt={`Avatar ${profile.name}`}
              class="h-full w-full object-cover"
            />
          </div>

        </div>

        <!-- Small accent -->
        <span
          class="absolute bottom-4 right-3 h-5 w-5 rounded-full border-4 border-[var(--background)] bg-[var(--accent)]"
        ></span>

      </div>

    </div>

  </div>
</section>