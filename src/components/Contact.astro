---
import { profile } from "../data/profile";
import { social } from "../data/social";
import {
  siGithub,
  siInstagram,
  siWhatsapp,
  siTelegram,
} from "simple-icons/icons";

const iconMap: Record<string, any> = {
  github: siGithub,
  instagram: siInstagram,
  whatsapp: siWhatsapp,
  telegram: siTelegram,
};
---

<section id="contact" class="section">
  <div class="container">
    <div class="mx-auto max-w-3xl text-center">

      <p class="section-label">
        Kontak
      </p>

      <h2 class="section-title mt-3">
        Mari Terhubung
      </h2>

      <p
        class="mx-auto mt-5 max-w-xl text-base leading-7 text-[var(--muted)] sm:text-lg"
      >
        Terbuka untuk kesempatan kerja, kolaborasi, maupun diskusi
        mengenai pengembangan perangkat lunak dan teknologi.
      </p>

      <!-- Primary CTA -->
      <div class="mt-8">
        <a
          class="button button-primary"
        >
          Hubungi Saya
        </a>
      </div>

      <!-- Social Links -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        {social.map((item) => {
          const icon = iconMap[item.type];

          return (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-2.5 rounded-full border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-sm font-medium text-[var(--muted)] shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--primary)]/40 hover:text-[var(--primary)] hover:shadow-md"
            >
              {item.type === "email" ? (

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  class="h-4 w-4 shrink-0 transition-transform duration-200 group-hover:scale-110"
                  aria-hidden="true"
                >
                  <rect
                    x="3"
                    y="5"
                    width="18"
                    height="14"
                    rx="2"
                    stroke="currentColor"
                    stroke-width="1.8"
                  />
                  <path
                    d="M4 7L12 13L20 7"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>

              ) : item.type === "linkedin" ? (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="h-4 w-4 shrink-0 transition-transform duration-200 group-hover:scale-110"
                  aria-hidden="true"
                >
                  <path
                    d="M5.2 3.5A2.2 2.2 0 1 1 5.2 7.9A2.2 2.2 0 0 1 5.2 3.5ZM3.3 9.4H7.1V20.5H3.3V9.4ZM9.1 9.4H12.7V10.9H12.8C13.3 10 14.5 9 16.3 9C20.1 9 20.7 11.4 20.7 14.5V20.5H16.9V15.2C16.9 13.9 16.9 12.3 15.2 12.3C13.5 12.3 13.2 13.6 13.2 15V20.5H9.4L9.1 9.4Z"
                  />
                </svg>

              ) : icon ? (
                <svg
                  viewBox="0 0 24 24"
                  class="h-4 w-4 shrink-0 transition-transform duration-200 group-hover:scale-110"
                  fill={`#${icon.hex}`}
                  aria-hidden="true"
                >
                  <path d={icon.path} />
                </svg>
              ) : null}

              <span>{item.name}</span>
              <span
                aria-hidden="true"
                class="relative flex h-4 w-4 items-center justify-center overflow-hidden"
              >
                <svg
                  viewBox="0 0 16 16"
                  fill="none"
                  class="absolute h-3.5 w-3.5 translate-x-0 translate-y-0 transition-transform duration-300 ease-out group-hover:translate-x-1 group-hover:-translate-y-1"
                >
                  <path
                    d="M4 12L12 4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                  <path
                    d="M6.5 4H12V9.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          );
        })}
      </div>

      <!-- <div class="mt-12 border-t border-[var(--border)] pt-6">
        <p class="text-xs text-[var(--muted)]">
          © {new Date().getFullYear()} {profile.name}
        </p>
      </div> -->

    </div>
  </div>
</section>