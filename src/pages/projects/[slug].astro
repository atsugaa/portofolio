---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: {
      slug: project.slug,
    },
    props: {
      project,
    },
  }));
}

const { project } = Astro.props;
---

<Layout
  title={`${project.title} — Agusta`}
  description={project.description}
>
  <main class="container py-16 sm:py-24">

    <!-- Back -->
    <a
      href="/#projects"
      class="inline-flex items-center gap-2 text-sm text-[var(--muted)] transition hover:text-[var(--foreground)]"
    >
      ← Kembali ke proyek
    </a>

    <!-- Header -->
    <header class="mt-10 max-w-4xl">

      <p class="text-sm font-medium text-[var(--primary)]">
        {project.category}
      </p>

      <div class="mt-3 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          {project.title}
        </h1>

        {project.year && (
          <span class="text-sm text-[var(--muted)]">
            {project.year}
          </span>
        )}
      </div>

      <p class="mt-6 max-w-3xl text-lg leading-8 text-[var(--muted)]">
        {project.description}
      </p>

      <!-- Technologies -->
      <div class="mt-6 flex flex-wrap gap-2">
        {project.technologies.map((technology) => (
          <span
            class="rounded-full border border-[var(--border)] px-3 py-1.5 text-sm text-[var(--muted)]"
          >
            {technology}
          </span>
        ))}
      </div>

      <!-- Links -->
      <div class="mt-8 flex flex-wrap gap-3">

        {project.github && (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-[var(--radius)] bg-[var(--primary)] px-5 py-3 text-sm font-medium text-[var(--primary-foreground)] transition hover:opacity-90"
          >
            Lihat GitHub ↗
          </a>
        )}

        {project.demo && (
          <a
            href={project.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-[var(--radius)] border border-[var(--border)] px-5 py-3 text-sm font-medium transition hover:bg-black/5 dark:hover:bg-white/5"
          >
            Demo Langsung ↗
          </a>
        )}

        {project.video && (
          <a
            href={project.video}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-[var(--radius)] border border-[var(--border)] px-5 py-3 text-sm font-medium transition hover:bg-black/5 dark:hover:bg-white/5"
          >
            Lihat Gameplay ↗
          </a>
        )}

      </div>
    </header>

    <!-- Main Image -->
    {project.image && (
      <div class="mt-12 overflow-hidden rounded-[var(--radius)] border border-[var(--border)]">
        <img
          src={project.image}
          alt={project.title}
          class="w-full object-cover"
        />
      </div>
    )}

    <!-- Gallery -->
    {project.gallery && project.gallery.length > 0 && (
      <section class="mt-8 grid gap-6 sm:grid-cols-2">
        {project.gallery.map((image) => (
          <div class="overflow-hidden rounded-[var(--radius)] border border-[var(--border)]">
            <img
              src={image}
              alt={`${project.title} screenshot`}
              loading="lazy"
              class="w-full object-cover"
            />
          </div>
        ))}
      </section>
    )}

  </main>
</Layout>